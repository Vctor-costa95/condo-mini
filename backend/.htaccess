Options -Indexes
RewriteEngine On

# Alguns servidores CGI descartam o cabeçalho Authorization.
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Código, SQL, configuração e arquivos enviados nunca são servidos diretamente.
RewriteRule ^(lib|sql|storage|scripts)(/|$) - [F,L]
RewriteRule ^(config|config\.example)\.php$ - [F,L]
RewriteRule (^|/)\. - [F,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [QSA,L]
