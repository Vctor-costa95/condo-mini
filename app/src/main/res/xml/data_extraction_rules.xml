<?xml version="1.0" encoding="utf-8"?><!--
   Backup e transferência entre aparelhos (Android 12+). A sessão fica de fora:
   a chave que a protege está no Keystore deste aparelho.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="session.xml" />
    </device-transfer>
</data-extraction-rules>
